APP_NAME="SKARP IoT Dashboard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Dockploy / Docker memakai MariaDB internal dari docker-compose.yml.
# Untuk development lokal tanpa Docker, Anda dapat tetap memakai sqlite.
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=skarp
DB_USERNAME=skarp
DB_PASSWORD=ganti_password_database_yang_panjang
DB_ROOT_PASSWORD=ganti_root_password_yang_panjang
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# ============================================
# FIREBASE (Client-side — untuk Blade/JS)
# ============================================
FIREBASE_API_KEY=AIzaSyBp4_SCK5DzscVFDcufN65nt3IGVp3ZQHw
FIREBASE_AUTH_DOMAIN=esp-firebase-demo-81e29.firebaseapp.com
FIREBASE_DATABASE_URL=https://esp-firebase-demo-81e29-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_PROJECT_ID=esp-firebase-demo-81e29
FIREBASE_STORAGE_BUCKET=esp-firebase-demo-81e29.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ============================================
# FIREBASE ADMIN (Server-side — untuk recap API)
# ============================================
# Download dari Firebase Console > Project Settings > Service Accounts > Generate new private key
# Path absolut di dalam container. Buat persistent volume di Dockploy ke path ini.
FIREBASE_CREDENTIALS=/var/www/html/storage/app/firebase-credentials.json

# ============================================
# WHATSAPP via Fonnte
# ============================================
FONNTE_TOKEN=your_fonnte_token
WA_TARGET_NUMBER=6289912345678

# Ambang status rekap/dashboard, ambang alert ekstrem WhatsApp, dan jeda pesan
ALERT_AMONIA_THRESHOLD=25
ALERT_THI_THRESHOLD=83
ALERT_EXTREME_AMONIA_THRESHOLD=50
ALERT_EXTREME_THI_THRESHOLD=85
ALERT_COOLDOWN_MINUTES=30

# ============================================
# KEAMANAN
# ============================================
RECAP_SECRET=ganti_dengan_string_acak_panjang
